# ==============================================================================
# RESEARCH SURVEY APP - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

PORT=3000
NODE_ENV=development

# Admin Authentication
ADMIN_PASSWORD=admin123
ADMIN_SECRET=mrp-academic-research-survey-jwt-secret-key-2026

# Database Configuration (Local Development)
DATABASE_PATH=database/research.sqlite3

# Vercel / Production Persistent Database (Optional - Turso / Hosted libSQL)
# When deploying to Vercel serverless, set these variables to persist SQLite data in the cloud:
# TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token
